# Documentation template only. The application reads process environment, not .env files.
# OPENAI_API_KEY must be supplied locally; never put it in Git.
NEXYDAO_MODEL=gpt-4o-mini
NEXYDAO_DB=data/nexydao.sqlite3
NEXYDAO_API_BUDGET_USD=1.00
# Set BOTH rates to current USD per million tokens for your selected model.
# Defaults deliberately block real API calls until rates are configured.
NEXYDAO_INPUT_USD_PER_MILLION=0
NEXYDAO_OUTPUT_USD_PER_MILLION=0
NEXYDAO_MAX_OUTPUT_TOKENS=1200
NEXYDAO_BROKER_MODE=paper
NEXYDAO_EXECUTION_ENABLED=false
# Optional protected owner-managed policy file; absent means mandatory built-in rules.
# A configured missing/invalid file stops the application. Never store credentials here.
NEXYDAO_OWNER_POLICY_FILE=
# Optional read-only IBKR Gateway check. No credentials belong here.
NEXYDAO_IBKR_HOST=127.0.0.1
NEXYDAO_IBKR_PORT=4002
NEXYDAO_IBKR_CLIENT_ID=91
NEXYDAO_IBKR_TIMEOUT_SECONDS=15
NEXYDAO_IBKR_EXPECTED_ACCOUNT=
NEXYDAO_IBKR_SNAPSHOT=data/ibkr-paper-snapshot.json
# Market checks require the exact paper pin and a private 32-byte random key file.
NEXYDAO_EVIDENCE_KEY_FILE=
NEXYDAO_MARKET_SYMBOL=SPY
NEXYDAO_MARKET_SNAPSHOT=data/market-quote.json
# Opt-in SEC research: one to three symbol/ten-digit CIK pairs, configured locally.
NEXYDAO_RESEARCH_UNIVERSE=[]
# Operator-selected approved US-GAAP concepts; at most nine issuer/concept facts.
NEXYDAO_RESEARCH_CONCEPTS=["Assets","NetIncomeLoss"]
# Real operator contact in NexyDAO/version User-Agent; never send placeholder requests.
NEXYDAO_SEC_USER_AGENT=
NEXYDAO_RESEARCH_SNAPSHOT=data/sec-research.json
# Optional public-key SEC receipts; legacy HMAC remains the default.
NEXYDAO_RESEARCH_RECEIPT_MODE=hmac-sha256
# Ed25519 consumer: pinned public DER only. Signing key is collector-only.
NEXYDAO_RESEARCH_PUBLIC_KEY_FILE=
NEXYDAO_RESEARCH_PUBLIC_KEY_SHA256=
NEXYDAO_RESEARCH_SIGNING_KEY_FILE=
# Optional Unix verified publication: collector-owned 2750 directory/read-only group.
NEXYDAO_RESEARCH_READ_GROUP=
# Optional absolute protected OpenSSL path; platform default applies when unset.
# NEXYDAO_OPENSSL_PATH=/usr/bin/openssl
NEXYDAO_ACCOUNT_AUDIT_SNAPSHOT=data/account-audit.json
NEXYDAO_BROKER_STATE_SNAPSHOT=data/broker-state.json
# Diagnostic allocation cap, bounded to the $5,000 simulation mandate.
# Positive USD reserve is a planning buffer, not a verified broker commission quote.
NEXYDAO_ALLOCATION_USD=5000
NEXYDAO_FEE_RESERVE_USD=50
# Set to consume a fresh signed API-visible order snapshot during allocation-check.
NEXYDAO_ORDERS_SNAPSHOT=data/broker-orders.json
# Optional read-only execution/fee observations: new Ed25519 receipt type, no HMAC fallback.
# Dedicated signer stays with the collector; a report consumer needs only public key+pin.
NEXYDAO_EXECUTION_RECEIPT_PUBLIC_KEY_FILE=
NEXYDAO_EXECUTION_RECEIPT_PUBLIC_KEY_SHA256=
NEXYDAO_EXECUTION_RECEIPT_SIGNING_KEY_FILE=
NEXYDAO_EXECUTIONS_SNAPSHOT=data/broker-executions.json
NEXYDAO_SETTLEMENT_SNAPSHOT=data/settlement-summary.json
# Optional Client Portal Web API reader, fixed HTTPS 127.0.0.1:5000, paper-only.
# Supply a trusted CA for a certificate valid for 127.0.0.1; verification is mandatory.
NEXYDAO_WEB_CA_FILE=
NEXYDAO_WEB_TIMEOUT_SECONDS=15
# Leave unset until the authenticated gateway and fresh receipt are validated.
# NEXYDAO_WEB_LEDGER_SNAPSHOT=data/web-ledger.json
